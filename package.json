{
  "name": "puff-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "vite build && node src/server/main.ts",
    "serve": "node src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node src/sim/run.ts",
    "loadtest": "node src/bots/loadtest.ts",
    "bots": "node src/bots/fill.ts",
    "categories:import": "node scripts/import-categories.ts",
    "categories:generate": "node scripts/generate-category.ts",
    "rarity:recompute": "node scripts/recompute-rarity.ts"
  },
  "dependencies": {
    "preact": "^10.26.0",
    "qrcode-generator": "^1.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
